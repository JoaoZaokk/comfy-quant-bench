 import os
+import threading
 import yaml
 import folder_paths
 import logging
 
+# A section on a busy network share can take tens of seconds per stat, and every model
+# list (startup and each /object_info) stats all of its folders, which stalls the server.
+SECTION_TIMEOUT = 10.0
+
+def paths_respond(paths):
+    probe = threading.Thread(target=lambda: [os.path.isdir(p) for p in paths], daemon=True)
+    probe.start()
+    probe.join(SECTION_TIMEOUT)
+    return not probe.is_alive()
+
