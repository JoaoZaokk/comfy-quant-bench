diff --git a/nodes/utils.py b/nodes/utils.py
index d131e1d..727b364 100644
--- a/nodes/utils.py
+++ b/nodes/utils.py
@@ -1,3 +1,4 @@
+import contextlib
 import sys
 
 folder_paths = None
@@ -11,4 +12,28 @@ except (ImportError, ModuleNotFoundError):
 get_filename_list = get_filename_list
 get_full_path_or_raise = get_full_path_or_raise
 
-__all__ = ["get_filename_list", "get_full_path_or_raise", "folder_paths"]
+
+@contextlib.contextmanager
+def eager_linear_init():
+    """
+    Build ComfyUI layers with real weight/bias tensors even when dynamic VRAM is on.
+
+    With dynamic VRAM, ComfyUI's ``Linear`` leaves ``weight`` and ``bias`` as ``None`` until its state dict
+    loads. The Nunchaku loaders swap those layers for ``SVDQW4A4Linear`` in between, reading
+    ``weight.dtype``/``weight.device`` and ``bias is not None``, so they need the eager layers.
+    The model is then managed by a regular (non-dynamic) ModelPatcher, as before.
+    """
+    try:
+        import comfy.memory_management as memory_management
+    except ImportError:
+        yield
+        return
+    enabled = getattr(memory_management, "aimdo_enabled", False)
+    memory_management.aimdo_enabled = False
+    try:
+        yield
+    finally:
+        memory_management.aimdo_enabled = enabled
+
+
+__all__ = ["get_filename_list", "get_full_path_or_raise", "folder_paths", "eager_linear_init"]
