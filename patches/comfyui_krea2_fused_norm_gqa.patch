+def _mod_scale(norm, scale):
+    # (1 + w)(1 + scale) - 1 in fp32: the RMSNorm's zero-centred weight folded into the modulation scale
+    w = comfy.model_management.cast_to(norm.scale, dtype=torch.float32, device=scale.device)
+    return ((1.0 + w) * (1.0 + scale.float()) - 1.0).to(scale.dtype)
+
