+def _modulated_rms(norm, x, scale, shift):
+    # rmsnorm(x) * (1 + w) * (1 + scale) + shift in one fused kernel with one rounding; the eager path rounds three times
+    if comfy.model_management.in_training:
+        return (1 + scale) * norm(x) + shift
+    return comfy.quant_ops.ck.rms_adaln(x.contiguous(), _mod_scale(norm, scale), shift, norm.eps)
+
