+# Local patch (2026-10-02, fase 3): COMFY_SWIGLU_TRITON=1 fuses silu(gate) * up into one Triton kernel for the eager path
+# (the INT8 kernel already fuses it; W4A4 ConvRot, bf16 and everything else materialize the intermediate twice).
+# Measured on the 3090 at Qwen-Image-2.1 1024² (4096 x 24576 bf16): 0.650 -> 0.386 ms per call, 32 calls per forward.
+_SWIGLU_TRITON = os.environ.get("COMFY_SWIGLU_TRITON", "").strip() == "1"
+_swiglu_kernel = None
+
+
+def _swiglu_triton(x):
+    global _swiglu_kernel
+    import triton
+    import triton.language as tl
+    if _swiglu_kernel is None:
+        @triton.jit
+        def _k(h_ptr, out_ptr, HALF, stride_h, stride_o, BLOCK: tl.constexpr):
+            row = tl.program_id(0)
+            offs = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+            mask = offs < HALF
+            g = tl.load(h_ptr + row * stride_h + offs, mask=mask, other=0.0).to(tl.float32)
+            u = tl.load(h_ptr + row * stride_h + HALF + offs, mask=mask, other=0.0).to(tl.float32)
+            tl.store(out_ptr + row * stride_o + offs, (g * tl.sigmoid(g) * u).to(out_ptr.dtype.element_ty), mask=mask)
+        _swiglu_kernel = _k
+    shape = x.shape
+    h = x.reshape(-1, shape[-1])
+    if h.stride(-1) != 1:
+        h = h.contiguous()
+    half = shape[-1] // 2
+    out = torch.empty(h.shape[0], half, device=x.device, dtype=x.dtype)
+    _swiglu_kernel[(h.shape[0], triton.cdiv(half, 2048))](h, out, half, h.stride(0), out.stride(0), BLOCK=2048, num_warps=8)
+    return out.reshape(*shape[:-1], half)
+
