+# COMFY_SAGE_QK_GRAN=per_thread (default, the kernel wrapper's own) | per_warp: granularity of the int8 Q/K scales. Measured
+# 2026-10-02 (fase 3): per_warp is ~3 % faster and 1.7x more accurate on Krea2 GQA heads (0.065 vs 0.111 vs SDPA fp32),
+# ~6 % less accurate on Qwen-Image-2.1 (0.0486 vs 0.0458); see .scratch/quantfunc_2026-10-01/otimizacao/attn_sm86_matrix_out.txt.
+SAGE_QK_GRAN = os.environ.get("COMFY_SAGE_QK_GRAN", "per_thread").strip() or "per_thread"
