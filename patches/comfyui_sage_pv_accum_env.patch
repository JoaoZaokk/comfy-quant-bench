+@functools.lru_cache(maxsize=None)
+def _sage_sm8x(device):
+    # the direct SM80 kernel covers sm80/86/87; other archs keep sageattn's own dispatch
+    return device.type == "cuda" and torch.cuda.get_device_capability(device) in ((8, 0), (8, 6), (8, 7))
+
+
+def _sage_pv_fp16_scaled(q, k, v, tensor_layout, sm_scale, smooth_k=None, qk_gran=None):
+    # The fp16 P.V accumulators of the SM80 kernel overflow to inf (NaN after the softmax division: black images) when
+    # |V| is large and the attention is flat: "fp16+fp32" sums one K tile in fp16 before adding to fp32 (32 keys for
+    # head_dim 128 non-causal, 64 otherwise: blk_k in sageattention/core.py; measured inf above |V| ~ 2047 with P ~ 1),
+    # "fp16" sums the whole row. Seen on Krea2, Z-Image and Nunchaku Qwen-Image-Edit (2026-10-01/02). Scaling each
+    # (head, channel) column of V by a power of two so that |V| <= 1 bounds those sums by the tile size and by the key
+    # count; the scaling and the final rescale are exact, nothing synchronizes with the host, and the Sage error itself
+    # (int8 Q/K) is unchanged.
+    seq_dim = 2 if tensor_layout == "HND" else 1
+    scale = torch.exp2(torch.log2(torch.linalg.vector_norm(v, float("inf"), dim=seq_dim, keepdim=True).float().clamp_(min=1.0)).ceil_())
+    accum = SAGE_PV_ACCUM
+    smooth_v = False
+    if accum == "fp16sv":
+        # "fp16" plus the kernel's own V-mean subtraction (accum_f16_fuse_v_mean): the fp16 row sum then accumulates
+        # V - mean(V) instead of V, which removes the rounding error a DC component builds over thousands of keys
+        # (measured 2026-10-02: 0.11 -> 0.0015 relative error at 16k keys with V ~ 50 +- 20). |V - mean| <= 2 after the
+        # scaling, so the row sum is bounded by 2 * keys: fall back to fp16+fp32 above 32752 keys.
+        accum, smooth_v = "fp16", True
+        if k.shape[seq_dim] > 32752:
+            accum, smooth_v = "fp16+fp32", False
+    elif accum == "fp16" and k.shape[seq_dim] > 65504:
+        accum = "fp16+fp32"  # the full-row fp16 sum is bounded by the key count only
+    out = _sageattn_pv_fp16_cuda(q, k, v * torch.reciprocal(scale).to(v.dtype), tensor_layout=tensor_layout, is_causal=False,
+                                 sm_scale=sm_scale, pv_accum_dtype=accum,
+                                 smooth_k=SAGE_SMOOTH_K if smooth_k is None else smooth_k, smooth_v=smooth_v,
+                                 qk_quant_gran=SAGE_QK_GRAN if qk_gran is None else qk_gran)
+    head_dim = 1 if tensor_layout == "HND" else 2
+    if scale.shape[head_dim] != out.shape[head_dim]:  # GQA: each K/V head serves a run of consecutive Q heads
+        scale = scale.repeat_interleave(out.shape[head_dim] // scale.shape[head_dim], dim=head_dim)
+    return out.mul_(scale)
+
+
+def _sage_dominant_heads(k, tensor_layout):
+    # Heads where every key is almost the same vector (|K - mean K| < threshold * |mean K|) carry one dominant coordinate;
+    # the int8 quantization of Q/K there put the Sage kernels 10-90 % away from exact attention on Nunchaku Qwen-Image-Edit
+    # (4 of 24 heads, blocks 0 and 52) and Krea2 (1 of 12 K/V heads, block 5), measured 2026-10-02 against SDPA fp32.
+    seq_dim = 2 if tensor_layout == "HND" else 1
+    kf = (k[:, :, ::8] if tensor_layout == "HND" else k[:, ::8]).float()   # every 8th key: the structure is per head, not per key
+    km = kf.mean(dim=seq_dim, keepdim=True)
+    spread = (kf - km).norm(dim=-1).mean(dim=seq_dim)                    # (B, H): mean distance of a key from the mean key
+    return (spread < SAGE_HYBRID * km.norm(dim=-1).squeeze(seq_dim)).any(dim=0)   # (H,)
+
+
+def _sage_hybrid(q, k, v, tensor_layout, sm_scale, sage):
+    flags = _sage_dominant_heads(k, tensor_layout)
+    hd = 1 if tensor_layout == "HND" else 2
+    groups = q.shape[hd] // k.shape[hd]                                  # GQA: a K/V head serves `groups` consecutive Q heads
+    flags_q = flags.repeat_interleave(groups) if groups > 1 else flags
+    if not bool(flags.any()):                                             # one host sync per call
+        return sage(q, k, v)
+    keep_q, keep_k = (~flags_q).nonzero().flatten(), (~flags).nonzero().flatten()
+    exact_q, exact_k = flags_q.nonzero().flatten(), flags.nonzero().flatten()
+    out = torch.empty_like(q)
+    if keep_q.numel():
+        out.index_copy_(hd, keep_q, sage(q.index_select(hd, keep_q), k.index_select(hd, keep_k), v.index_select(hd, keep_k)))
+    qs, ks, vs = q.index_select(hd, exact_q), k.index_select(hd, exact_k), v.index_select(hd, exact_k)
+    if tensor_layout == "NHD":
+        qs, ks, vs = (t.transpose(1, 2) for t in (qs, ks, vs))
+    o = comfy.ops.scaled_dot_product_attention(qs, ks, vs, attn_mask=None, dropout_p=0.0, is_causal=False, scale=sm_scale, enable_gqa=groups > 1)
+    out.index_copy_(hd, exact_q, o.transpose(1, 2) if tensor_layout == "NHD" else o)
+    return out
+
+
