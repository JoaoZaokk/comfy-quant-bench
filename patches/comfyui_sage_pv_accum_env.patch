+                    return _sageattn_pv_fp16_cuda(q, k, v, tensor_layout=tensor_layout, is_causal=False, sm_scale=sage_kwargs["sm_scale"],
+                                                  pv_accum_dtype="fp32", smooth_k=smooth_k, qk_quant_gran=qk_gran)
+                return _sage_pv_fp16_scaled(q, k, v, tensor_layout, sage_kwargs["sm_scale"], smooth_k, qk_gran)
+            out = _sage_hybrid(q, k, v, tensor_layout, sage_kwargs["sm_scale"], sage) if SAGE_HYBRID > 0 else sage(q, k, v)
