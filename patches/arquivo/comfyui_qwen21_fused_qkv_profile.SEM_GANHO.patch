+def fused_convrot_qkv(linears, x):
+    """One ConvRot activation quantize for linears that share ``x``.
+
+    Returns ``[..., sum of out_features]`` with the linears' outputs concatenated
+    on the last dim, or None when any linear is not a plain ConvRot W4A4 weight.
+    The activation rotation and its quantize read ``x`` once; each output row
+    stays an independent INT4 product, so the split matches three separate calls.
+    """
+    if comfy.model_management.in_training or not linears:
+        return None
+    held = []
+    try:
+        group = linear_dtype = quant_group = None
+        qdatas = []
+        scales = []
+        for linear in linears:
+            stored = getattr(linear, "weight", None)
+            if (not isinstance(stored, QuantizedTensor)
+                    or stored._layout_cls != "TensorCoreConvRotW4A4Layout"
+                    or getattr(stored._params, "transposed", False)
+                    or len(linear.weight_function) or len(linear.bias_function)
+                    or getattr(linear, "_full_precision_mm", False)
+                    or linear.bias is not None):
+                return None
+            weight, bias, stream = cast_bias_weight(
+                linear, input=None, dtype=linear.weight.dtype, device=x.device,
+                bias_dtype=x.dtype, offloadable=True, compute_dtype=x.dtype, want_requant=True)
+            held.append((linear, weight, bias, stream))
+            if bias is not None or not isinstance(weight, QuantizedTensor):
+                return None
+            params = weight._params
+            key = (params.convrot_groupsize, params.linear_dtype, params.quant_group_size)
+            if group is None:
+                group, linear_dtype, quant_group = key
+            elif key != (group, linear_dtype, quant_group):
+                return None
+            qdata, scale = weight.layout_cls.get_plain_tensors(weight)
+            qdatas.append(qdata)
+            scales.append(scale.reshape(-1))
+        return quant_ops.ck.convrot_w4a4_linear(
+            x, torch.cat(qdatas, 0), torch.cat(scales, 0), None, group, quant_group, linear_dtype)
+    finally:
+        for linear, weight, bias, stream in held:
+            uncast_bias_weight(linear, weight, bias, stream)
+
