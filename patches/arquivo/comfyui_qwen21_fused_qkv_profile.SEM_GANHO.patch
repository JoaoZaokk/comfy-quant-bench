+def _prof_begin():
+    if not _PROFILE or not torch.cuda.is_available():
+        return None
+    start = torch.cuda.Event(enable_timing=True)
+    start.record()
+    return start
+
+
+def _prof_end(name, start):
+    global _profile_steps
+    if start is None:
+        return
+    end = torch.cuda.Event(enable_timing=True)
+    end.record()
+    _profile_pending.append((name, start, end))
+
+
+def _prof_flush(force=False):
+    global _profile_steps
+    if not _profile_pending:
+        return
+    torch.cuda.synchronize()
+    for name, start, end in _profile_pending:
+        _profile_ms[name] = _profile_ms.get(name, 0.0) + start.elapsed_time(end)
+    _profile_pending.clear()
+    _profile_steps += 1
+    if force or _profile_steps >= 25:
+        lines = [f"steps {_profile_steps}"]
+        for name, ms in sorted(_profile_ms.items(), key=lambda kv: -kv[1]):
+            lines.append(f"{name} {ms:.1f}")
+        with open(_PROFILE_PATH, "w", encoding="utf-8") as fh:
+            fh.write("\n".join(lines) + "\n")
+        _profile_ms.clear()
+        _profile_steps = 0
