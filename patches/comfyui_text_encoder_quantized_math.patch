diff --git a/tests-unit/comfy_quant/test_text_encoder_quantized_matmul.py b/tests-unit/comfy_quant/test_text_encoder_quantized_matmul.py
new file mode 100644
index 00000000..c6212048
--- /dev/null
+++ b/tests-unit/comfy_quant/test_text_encoder_quantized_matmul.py
@@ -0,0 +1,95 @@
+import json
+import os
+import sys
+from types import SimpleNamespace
+from unittest import mock
+
+import torch
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", ".."))
+
+from comfy.cli_args import args  # noqa: E402
+
+if not torch.cuda.is_available():
+    args.cpu = True
+
+import comfy.sd  # noqa: E402
+from comfy import ops  # noqa: E402
+from comfy.quant_ops import QuantizedTensor  # noqa: E402
+
+
+def quantized_state_dict(layer_conf):
+    weight = torch.randn(16, 64, dtype=torch.bfloat16, generator=torch.Generator().manual_seed(7))
+    q_weight = QuantizedTensor.from_float(weight, "TensorWiseINT8Layout", per_channel=True)
+    return {
+        "layer.weight": q_weight._qdata,
+        "layer.weight_scale": q_weight._params.scale,
+        "layer.comfy_quant": torch.tensor(list(json.dumps(layer_conf).encode("utf-8")), dtype=torch.uint8),
+        "plain.weight": torch.randn(16, 16, dtype=torch.bfloat16),
+    }
+
+
+class TinyTextEncoder(torch.nn.Module):
+    """One quantized linear and one plain linear, built the way sd1_clip builds a quantized TE."""
+
+    def __init__(self, device="cpu", dtype=None, model_options={}):
+        super().__init__()
+        operations = ops.mixed_precision_ops({}, torch.bfloat16, full_precision_mm=True)
+        self.layer = operations.Linear(64, 16, bias=False, device=device, dtype=torch.bfloat16)
+        self.plain = operations.Linear(16, 16, bias=False, device=device, dtype=torch.bfloat16)
+        self.dtypes = {torch.bfloat16}
+
+
+class TinyTokenizer:
+    def __init__(self, embedding_directory=None, tokenizer_data={}):
+        pass
+
+
+def build(layer_conf, disabled=frozenset()):
+    target = SimpleNamespace(params={}, clip=TinyTextEncoder, tokenizer=TinyTokenizer)
+    with mock.patch.object(ops, "get_disabled_quant_formats", return_value=set(disabled)):
+        return comfy.sd.CLIP(target, state_dict=quantized_state_dict(layer_conf), model_options={"initial_device": torch.device("meta")})
+
+
+def test_full_precision_matrix_mult_layer_keeps_the_float32_upcast():
+    clip = build({"format": "int8_tensorwise", "full_precision_matrix_mult": True})
+    assert clip.quantized_matmul is False
+    assert clip.patcher.force_cast_weights is True
+
+
+def test_quantized_layer_runs_natively_without_the_upcast():
+    clip = build({"format": "int8_tensorwise"})
+    assert clip.quantized_matmul is True
+    assert clip.patcher.force_cast_weights is False
+    assert clip.clone().quantized_matmul is True
+
+
+def test_format_disabled_on_the_device_keeps_the_upcast():
+    clip = build({"format": "int8_tensorwise"}, disabled={"int8_tensorwise"})
+    assert clip.quantized_matmul is False
+    assert clip.patcher.force_cast_weights is True
+
+
+def test_disable_quantized_text_encoder_flag_keeps_the_upcast(monkeypatch):
+    monkeypatch.setattr(args, "disable_quantized_text_encoder", True)
+    clip = build({"format": "int8_tensorwise"})
+    assert clip.quantized_matmul is False
+    assert clip.patcher.force_cast_weights is True
+
+
+def test_quantized_matmul_is_only_switched_on_while_encoding():
+    clip = build({"format": "int8_tensorwise"})
+    layer = clip.cond_stage_model.layer
+    assert layer._full_precision_mm is True
+    with mock.patch.object(ops, "get_disabled_quant_formats", return_value=set()):
+        with clip.quantized_matmul_context(torch.device("cpu")):
+            assert layer._full_precision_mm is False
+            assert clip.cond_stage_model.plain._full_precision_mm is True
+    assert layer._full_precision_mm is True
+
+
+def test_plain_layers_alone_do_not_count_as_quantized():
+    model = torch.nn.Module()
+    model.plain = ops.mixed_precision_ops({}, torch.bfloat16, full_precision_mm=False).Linear(8, 8, device="cpu", dtype=torch.bfloat16)
+    with mock.patch.object(ops, "get_disabled_quant_formats", return_value=set()):
+        assert ops.has_quantized_matmul(model, torch.device("cpu")) is False
