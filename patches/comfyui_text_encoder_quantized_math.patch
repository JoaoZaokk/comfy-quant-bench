diff --git a/comfy/ops.py b/comfy/ops.py
index f4ac760c..5688384a 100644
--- a/comfy/ops.py
+++ b/comfy/ops.py
@@ -1334,6 +1334,28 @@ def _quantized_weight_state_dict(module, sd, prefix, extra_quant_conf=None, extr
     return sd
 
 
+def quantized_text_encoder_math(quant_config):
+    #Two independent things send a text encoder down the dequantized path: sd1_clip asks for
+    #full precision matmul, and sd.py upcasts every CLIP to float32, which sets
+    #comfy_force_cast_weights on every module. Either one alone is enough to keep the quantized
+    #kernel from ever running, so a quantized text encoder used to save VRAM and no time. Both
+    #are released together, and only for a checkpoint that actually carries quantized layers.
+    return quant_config is not None and not args.disable_quantized_text_encoder
+
+
+def text_encoder_has_quantized_math(model):
+    #The other half of the release, asked from the built module tree rather than from
+    #model_options: every text encoder family copies model_options before writing
+    #quantization_metadata into it, so the key never reaches the CLIP that owns the patcher. The
+    #tree also answers correctly for the composite encoders that wrap more than one model.
+    #_full_precision_mm is the marker the layer itself carries: only a MixedPrecisionOps layer has
+    #it, and it is False only when quantized_text_encoder_math said so.
+    for module in model.modules():
+        if getattr(module, "_full_precision_mm", True) is False:
+            return True
+    return False
+
+
 class MixedPrecisionOp(CastWeightBiasOp):
     quant_format = None
 
