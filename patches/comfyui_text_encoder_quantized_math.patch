diff --git a/comfy/ops.py b/comfy/ops.py
index b7783e0d..2feca299 100644
--- a/comfy/ops.py
+++ b/comfy/ops.py
@@ -1729,6 +1729,11 @@ def get_disabled_quant_formats(device=None):
     return disabled
 
 
+def has_quantized_matmul(model, device):
+    disabled = get_disabled_quant_formats(device)
+    return any(isinstance(module, MixedPrecisionOp) and module.can_use_quantized_matmul(disabled) for module in model.modules())
+
+
 @contextlib.contextmanager
 def use_quantized_matmul(model, device):
     disabled = get_disabled_quant_formats(device)
