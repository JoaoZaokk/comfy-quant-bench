+# SPDX-FileCopyrightText: Copyright (c) 2025 Comfy Org. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+"""Fused AWQ W4A16 weight dequantization: W[n, k] = (q[n, k] - 8) * wscales[k // G, n] + wzeros[k // G, n]."""
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _dequantize_awq_w4a16_kernel(q_ptr, s_ptr, z_ptr, out_ptr, N, K, G: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr):
+    rn = tl.program_id(0) * BN + tl.arange(0, BN)
+    rk = tl.program_id(1) * BK + tl.arange(0, BK)
+    mask = (rn[:, None] < N) & (rk[None, :] < K)
+    byte = tl.load(q_ptr + rn[:, None] * (K // 2) + rk[None, :] // 2, mask=mask, other=0).to(tl.int32) & 0xFF
+    nibble = tl.where(rk[None, :] % 2 == 0, byte & 0xF, byte >> 4).to(tl.float32)
+    group = rk[None, :] // G
+    s = tl.load(s_ptr + group * N + rn[:, None], mask=mask, other=0.0).to(tl.float32)
+    z = tl.load(z_ptr + group * N + rn[:, None], mask=mask, other=0.0).to(tl.float32)
+    tl.store(out_ptr + rn[:, None] * K + rk[None, :], ((nibble - 8.0) * s + z).to(out_ptr.dtype.element_ty), mask=mask)
+
+
+def dequantize_awq_w4a16(qweight: torch.Tensor, wscales: torch.Tensor, wzeros: torch.Tensor, group_size: int) -> torch.Tensor:
+    """(N, K // 2) packed uint4 + (K // G, N) scales/zeros -> (N, K) weight in the scales' dtype."""
+    n, k = qweight.shape[0], qweight.shape[1] * 2
+    out = torch.empty(n, k, dtype=wscales.dtype, device=qweight.device)
+    grid = (triton.cdiv(n, 32), triton.cdiv(k, 128))
+    _dequantize_awq_w4a16_kernel[grid](qweight.contiguous(), wscales.contiguous(), wzeros.contiguous(), out, n, k,
+                                       group_size, 32, 128)
+    return out
