diff --git a/fish_api_server_clamped.py b/fish_api_server_clamped.py
new file mode 100644
index 0000000..24a3f5f
--- /dev/null
+++ b/fish_api_server_clamped.py
@@ -0,0 +1,49 @@
+"""Launch the installed Fish API with a bounded S2 Pro KV cache.
+
+Fish 2.0.0 does not expose max_seq_len on api_server.py. This tiny launcher
+keeps the vendor checkout untouched and applies the same in-memory clamp used
+by this machine's validated inference scripts before delegating to the official
+server entrypoint.
+"""
+
+from __future__ import annotations
+
+import runpy
+import sys
+from pathlib import Path
+
+
+def pop_int_option(name: str, default: int) -> int:
+    if name not in sys.argv:
+        return default
+    index = sys.argv.index(name)
+    try:
+        value = int(sys.argv[index + 1])
+    except (IndexError, ValueError) as exc:
+        raise SystemExit(f"{name} requires an integer") from exc
+    del sys.argv[index : index + 2]
+    return value
+
+
+fish_root = Path.cwd()
+sys.path.insert(0, str(fish_root))
+max_seq_len = max(1024, pop_int_option("--max-seq-len", 4096))
+
+from fish_speech.models.text2semantic import inference as text2semantic  # noqa: E402
+
+original_init_model = text2semantic.init_model
+
+
+def init_model_clamped(*args, **kwargs):
+    model, decode_one_token = original_init_model(*args, **kwargs)
+    if model.config.max_seq_len > max_seq_len:
+        print(
+            f"[FishSpeechStudio] KV-cache: {model.config.max_seq_len} -> {max_seq_len}",
+            flush=True,
+        )
+        model.config.max_seq_len = max_seq_len
+    return model, decode_one_token
+
+
+text2semantic.init_model = init_model_clamped
+runpy.run_path(str(fish_root / "tools" / "api_server.py"), run_name="__main__")
