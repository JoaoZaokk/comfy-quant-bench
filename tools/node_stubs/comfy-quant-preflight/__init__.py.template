"""Loader stub. The package itself lives outside this checkout, on purpose.

`ComfyUI/` is an upstream git checkout with its own remote, and its .gitignore excludes
`/custom_nodes/`. Anything kept here is untracked by both repositories: invisible to this
project's history and destined to be lost in a reinstall. So the source of truth is

    F:/COMFY_PORTABLE/custom_nodes/comfy-quant-preflight/

which this project's repository tracks, and this file is the three lines ComfyUI needs to find
it. Nothing is duplicated -- editing the tracked copy changes what runs.
"""

import importlib.util
import sys
from pathlib import Path

_SOURCE = Path(__file__).resolve().parents[3] / "custom_nodes" / "comfy-quant-preflight"

NODE_CLASS_MAPPINGS = {}
NODE_DISPLAY_NAME_MAPPINGS = {}

if not _SOURCE.is_dir():
    # Loud, not silent: a preflight package that quietly fails to load is the exact failure it
    # exists to prevent.
    print(f"quant-preflight: source not found at {_SOURCE}; checks are NOT active")
else:
    _spec = importlib.util.spec_from_file_location(
        "comfy_quant_preflight", _SOURCE / "__init__.py",
        submodule_search_locations=[str(_SOURCE)])
    _module = importlib.util.module_from_spec(_spec)
    sys.modules["comfy_quant_preflight"] = _module
    _spec.loader.exec_module(_module)
    NODE_CLASS_MAPPINGS = getattr(_module, "NODE_CLASS_MAPPINGS", {})
    NODE_DISPLAY_NAME_MAPPINGS = getattr(_module, "NODE_DISPLAY_NAME_MAPPINGS", {})
