# Allowlist. This directory is a live ComfyUI Portable install (models ~600 GiB, python_embeded, an upstream ComfyUI
# checkout with its own .git) and the bench's local lab notebook (.scratch/, handoffs, logs, renders). Everything is
# ignored by default; only what is published is re-included below, by exact path. The previous, much longer version of
# this file (with the history of every hole it closed) is in git history before 2026-10-06.
/*

!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/pyproject.toml
!/__init__.py
!/compile_support.py
!/inspect_quant.py
!/_check_accel.py

# Nodes published here. comfy-qwen21-nunchaku and comfy-stream-video-save live in their own branches.
!/custom_nodes/
/custom_nodes/*
!/custom_nodes/comfy-lowbit-loader/
!/custom_nodes/comfy-quant-preflight/
!/custom_nodes/comfy-void-stage-tools/

# Converters, verifiers and the measurement harness the README documents, with their tests. Everything else in tools/
# (probes, one-off bench scripts, Colab/QAT runners) stays local.
!/tools/
/tools/*
!/tools/ck_swiglu/
!/tools/fixtures/
!/tools/_bench_guard.py
!/tools/_conversion.py
!/tools/_formats.py
!/tools/_native_probe.py
!/tools/_profiles.py
!/tools/_ram_guard.py
!/tools/_timing.py
!/tools/activation_balance.py
!/tools/calibrate_activations.py
!/tools/comfy_client.py
!/tools/compara_av.py
!/tools/convert.py
!/tools/erro_por_camada.py
!/tools/extrai_transformer.py
!/tools/gemma_chat.py
!/tools/gptq_w4a4.py
!/tools/gpu_lock.ps1
!/tools/gpu_lock.py
!/tools/gpu_lock_beat.ps1
!/tools/inspect_diffusion_arch.py
!/tools/junta_shards_safetensors.py
!/tools/lowbit_canon.py
!/tools/ltx_encode_lowcommit.py
!/tools/ltx_video.py
!/tools/metricas_imagem.py
!/tools/plot_weight_balance.py
!/tools/probe_lora_requant.py
!/tools/quality_battery.py
!/tools/quant_audit.py
!/tools/quant_awq_w4a16.py
!/tools/quant_gguf.py
!/tools/quant_int8.py
!/tools/quant_misto_w4a8_int8.py
!/tools/quant_mixed.py
!/tools/quant_te_residuos.py
!/tools/quant_w4a4.py
!/tools/quant_w4a4_smooth.py
!/tools/quant_w4a8.py
!/tools/quant_weight_only.py
!/tools/safetensors_to_gguf_bf16.py
!/tools/sampler_tempo_do_log.py
!/tools/svdq_to_bf16.py
!/tools/svdquant_probe.py
!/tools/test_comfy_client.py
!/tools/test_conversion_core.py
!/tools/test_formats_e2e.py
!/tools/test_gpu_lock.py
!/tools/test_native_probe.py
!/tools/test_quant_mixed_provenance.py
!/tools/test_quant_mixed_sigma.py
!/tools/test_smooth_guards.py
!/tools/test_svdq_verify.py
!/tools/test_svdq_write_contract.py
!/tools/test_timing.py
!/tools/test_verify_formats.py
!/tools/to_native.py
!/tools/verifica_patches.py
!/tools/verify_w4a4.py
!/tools/weight_balance.py
tools/*/build*/

# Patches to code this repo does not own (ComfyUI, comfy-kitchen, third-party nodes): updates erase them otherwise.
!/patches/
/patches/*
!/patches/*.patch
!/patches/README.md
!/patches/tests/
!/patches/arquivo/

# Only the figures the README embeds and the kernel write-up.
!/docs/
/docs/*
!/docs/kernel-optimization.md
!/docs/w4a4_vs_w4a8.png
!/docs/same_format_two_models.png
!/docs/weight_divergence.png
!/docs/where_the_line_is.png

# Criteria the README cites, and the Hugging Face cards (source of the published model pages).
!/bench/
/bench/*
!/bench/criterio_fechamento_2026-09-14.md
!/bench/criterio_hunyuan_misto.md
!/bench/criterio_lora.md
!/bench/criterio_ltx23.md
!/bench/hf/
/bench/hf/*
!/bench/hf/*/
/bench/hf/*/*
!/bench/hf/*/*.md
