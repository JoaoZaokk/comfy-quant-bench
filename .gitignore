!/bench/hf/qwen-image-edit-2511-quant/images/
/bench/hf/qwen-image-edit-2511-quant/images/*
!/bench/hf/qwen-image-edit-2511-quant/images/lora_lightning_4steps.png

# Phase-7 kernel experiment code (docs/kernel-optimization.md).
!/experiments/
experiments/**/build*/

__pycache__/
*.pyc
*.pyo
.hf/
